{
  "name": "legacy",
  "version": "1.0.0",
  "private": true,
  "description": "A database-backed, moderated digital legacy platform.",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "moderator:create": "node scripts/bootstrap-moderator.js",
    "import:profiles": "node scripts/import-profiles.js",
    "validate": "node scripts/validate-profiles.js",
    "test": "NODE_ENV=test node --test test/*.test.js",
    "test:e2e": "node test/e2e/legacy-flow.mjs",
    "build": "npm run validate && node --check src/app.js && node --check assets/js/app.js && node --check assets/js/site.js && node --check test/e2e/legacy-flow.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "argon2": "0.45.1",
    "csrf-sync": "4.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "10.0.10",
    "sqlite3": "6.0.1"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "supertest": "7.2.2"
  }
}
