NODE_ENV=development
PORT=3000
DATABASE_PATH=data/legacy.sqlite
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=0

# Optional public removal route. Use an https:// form URL or mailto: address.
PUBLIC_REMOVAL_URL=

# Password recovery requires either complete SMTP settings or the explicitly
# local-only development logger below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DEV_RECOVERY_LOG=true

